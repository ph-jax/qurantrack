{
  "name": "qurantrack",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "QuranTrack \u2014 Quran Learning & Progress Platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:staging": "CLOUDFLARE_ENV=staging VITE_ENABLE_UI_PREVIEW=true npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply qurantrack-preview --local",
    "db:migrate:remote": "wrangler d1 migrations apply qurantrack-production --env production --remote",
    "db:seed:local": "wrangler d1 execute qurantrack-preview --local --file seeds/demo_seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build:staging && wrangler deploy --config dist/qurantrack/wrangler.json --keep-vars",
    "db:migrate:staging": "wrangler d1 migrations apply qurantrack-staging --env staging --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "db:inspect:local": "wrangler d1 execute qurantrack-preview --local --command \"SELECT name, type FROM sqlite_master WHERE type IN ('table', 'index') ORDER BY type, name;\""
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.22",
    "@radix-ui/react-checkbox": "^1.3.10",
    "@radix-ui/react-dialog": "^1.1.22",
    "@radix-ui/react-dropdown-menu": "^2.1.23",
    "@radix-ui/react-label": "^2.1.14",
    "@radix-ui/react-select": "^2.3.6",
    "@radix-ui/react-switch": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.20",
    "@radix-ui/react-toast": "^1.2.22",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "latest",
    "i18next": "^26.3.6",
    "lucide-react": "^1.26.0",
    "react": "latest",
    "react-dom": "latest",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "^29.1.1",
    "prettier": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
